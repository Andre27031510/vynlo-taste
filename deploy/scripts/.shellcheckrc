# Shellcheck configuration for deploy scripts
# Disable warnings that are acceptable in our deployment scripts

# SC2086: Double quote to prevent globbing and word splitting
# Acceptable in deployment scripts where we control the environment
disable=SC2086

# SC1090: Can't follow non-constant source
# We use dynamic sourcing in some scripts
disable=SC1090

# SC2034: Variable appears unused
# Some variables are used in error messages
disable=SC2034

